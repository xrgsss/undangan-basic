# ============================================================
#  KONFIGURASI BACKEND (OPSIONAL)
#  Salin file ini menjadi `.env` lalu isi nilainya.
#  Jika dibiarkan kosong, undangan otomatis berjalan dalam
#  MODE DEMO (ucapan disimpan di localStorage browser).
# ============================================================

# --- Supabase (opsional, untuk RSVP & ucapan online) ---
# 1. Buat project di https://supabase.com
# 2. Jalankan file `supabase/schema.sql` di SQL Editor
# 3. Salin URL & anon key dari Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Info tambahan (dipakai untuk link share / Open Graph saat runtime) ---
VITE_SITE_URL=https://undangan-diana-hengki.example.com
